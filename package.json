{
  "name": "re-frame.vertica",
  "version": "0.3.1",
  "private": true,
  "description": "An in-app vertical slice through re-frame data flow",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/frknzd/re-frame.vertica.git"
  },
  "homepage": "https://github.com/frknzd/re-frame.vertica#readme",
  "bugs": "https://github.com/frknzd/re-frame.vertica/issues",
  "packageManager": "npm@10.8.2",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "test": "npm run test:cljs",
    "test:jvm": "lein test",
    "test:cljs": "shadow-cljs compile test",
    "build:preload": "shadow-cljs release preload",
    "build:fixtures": "shadow-cljs release fixture-react17 fixture-react18 && node scripts/build-fixtures.mjs",
    "build": "node scripts/clean.mjs && npm run build:preload && npm run build:fixtures",
    "verify": "npm run test:jvm && npm test && npm run build",
    "check:version": "node scripts/check-version.mjs",
    "release:patch": "bump-my-version bump patch",
    "release:minor": "bump-my-version bump minor",
    "release:major": "bump-my-version bump major"
  },
  "devDependencies": {
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "react17": "npm:react@17.0.2",
    "react-dom17": "npm:react-dom@17.0.2",
    "shadow-cljs": "3.1.7"
  }
}
